# Local development: copy this file to .env.local and replace the placeholder.
# Never commit your real API key. Vite loads .env.local for the server endpoint.
# AI Studio may inject GEMINI_API_KEY from its Secrets panel at runtime.
GEMINI_API_KEY="REPLACE_WITH_YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
